# Keep the build context (and image) small.
.venv
venv
.git
.gitignore
node_modules
**/__pycache__
**/*.pyc
**/*.pyo

# Not needed in the SLEEC-PATCH image
case_studies
expert_resolutions
crayon/app/uploads
crayon/app/instance
crayon/app/data
crayon/expert_resolutions
crayon/uploads
crayon/results
crayon/instance
*.pdf
proof.txt
simplified.txt

# Cloudflare/build artifacts
.wrangler
dist

# Keep inactive numbered/backup backend variants out of this deployment.
SLEECpatch/app/services/deterministic_repair_engine*.py
!SLEECpatch/app/services/deterministic_repair_engine.py
SLEECpatch/app/services/sleec_patch_workbench_engine*.py
!SLEECpatch/app/services/sleec_patch_workbench_engine.py
SLEECpatch/app/services/gpt_patch_engine*.py
!SLEECpatch/app/services/gpt_patch_engine.py
SLEECpatch/app/services/prompts*.py
!SLEECpatch/app/services/prompts.py
SLEECpatch/app/services/semantic_patch_validator*.py
!SLEECpatch/app/services/semantic_patch_validator.py
SLEECpatch/app/services/patch_operation_engine*.py
!SLEECpatch/app/services/patch_operation_engine.py
SLEECpatch/app/services/sleec_parser*.py
!SLEECpatch/app/services/sleec_parser.py
SLEECpatch/app/scripts/export_overleaf_tables*.py
!SLEECpatch/app/scripts/export_overleaf_tables.py

# Local credentials and research exports are never runtime inputs.
**/.env
**/.env.*
**/*.log
SLEECpatch/app/overleaf_generated

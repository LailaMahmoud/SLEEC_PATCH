def_start

    // events
    event DressingStarted
    event RecommendFormalWear
    event RecommendCasualWear
    event RecommendOtherwise
    event CaptureImage
    event DoNotStoreImages

    // measures
    measure clothingChoiceInappropriate:boolean
    measure userPrefersPrivacy:boolean
    measure userAdamant:boolean
    measure consentGranted:boolean

def_end


rule_start

    // Redundancy
    Rule1 when DressingStarted then RecommendFormalWear

    Rule2 when DressingStarted then RecommendFormalWear

    // Conflict
    Rule3 when DressingStarted and {clothingChoiceInappropriate}
        then RecommendFormalWear

    Rule4 when DressingStarted and {clothingChoiceInappropriate}
        then RecommendCasualWear

    // Privacy
    Rule5 when DressingStarted
        then CaptureImage
        unless (not {consentGranted})

    Rule6 when DressingStarted and {userPrefersPrivacy}
        then DoNotStoreImages

    // Recommendation
    Rule7 when DressingStarted and {clothingChoiceInappropriate}
        then RecommendOtherwise
        unless {userAdamant}

rule_end


concern_start

    c1 when DressingStarted and {userPrefersPrivacy}
        then not CaptureImage

concern_end